# Field-radio chatbot — Groq (OpenAI-compatible) credentials.
# Set these in the Vercel project dashboard (Settings -> Environment Variables),
# NOT in the repo. Locally, copy this file to .env (which is gitignored).

# Required: get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides (sensible defaults are baked in):
# Model used for replies. llama-3.3-70b-versatile sticks to the persona best;
# llama-3.1-8b-instant is faster and cheaper if you prefer.
GROQ_MODEL=llama-3.3-70b-versatile
