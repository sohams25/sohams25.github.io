---
// Faint topographic contour texture. Decorative only (aria-hidden). Drawn as
// layered SVG paths so it scales crisply and stays light. Sits behind hero
// content and reads as a survey map under the field log.
---
<div class="contour" aria-hidden="true">
  <svg viewBox="0 0 1200 520" preserveAspectRatio="xMidYMid slice" role="presentation">
    <g fill="none" stroke="var(--c-blue)" stroke-width="1">
      <path d="M-40 120 C 200 60, 420 180, 640 120 S 1040 40, 1260 130" />
      <path d="M-40 170 C 220 110, 440 230, 660 170 S 1060 90, 1260 180" />
      <path d="M-40 230 C 240 170, 470 300, 700 235 S 1080 150, 1260 245" />
      <path d="M-40 300 C 260 245, 500 380, 740 310 S 1100 220, 1260 320" />
      <path d="M-40 380 C 280 320, 540 460, 800 390 S 1120 300, 1260 400" />
      <path d="M-40 460 C 300 400, 580 540, 860 470 S 1140 380, 1260 480" />
    </g>
    <g fill="var(--c-rust)">
      <circle cx="640" cy="120" r="2.5" />
      <circle cx="700" cy="235" r="2.5" />
      <circle cx="800" cy="390" r="2.5" />
    </g>
  </svg>
</div>

<style>
  .contour {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    opacity: 0.16;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 55%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 0%, #000 55%, transparent 100%);
  }
  .contour svg { width: 100%; height: 100%; }
</style>
