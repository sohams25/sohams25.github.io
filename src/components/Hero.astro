---
import { profile } from '../data/site';
---
<section class="hero" id="top">
  <div class="wrap hero__grid">
    <div class="hero__lead">
      <p class="hero__eyebrow mono">{profile.role} · {profile.location}</p>

      <h1 class="hero__name">{profile.name}</h1>

      <p class="hero__tagline">{profile.tagline}</p>

      <p class="hero__role mono">{profile.roleLine}</p>

      <div class="hero__actions">
        <a class="btn btn--primary" href="#contact">Get in touch</a>
        <a class="btn btn--ghost" href={profile.links.cv} target="_blank" rel="noopener noreferrer">
          CV<span aria-hidden="true"> ↗</span>
        </a>
        <div class="hero__social">
          <a href={profile.links.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">GitHub</a>
          <span aria-hidden="true">·</span>
          <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">LinkedIn</a>
        </div>
      </div>
    </div>

    <figure class="hero__plate">
      <div class="hero__frame">
        <img
          src={profile.photo}
          alt={profile.photoAlt}
          width="520"
          height="520"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <figcaption class="hero__cap">
        <span class="hero__now label">Now</span>
        {profile.statusNow}
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(2.5rem, 1.5rem + 5vw, 5rem);
    padding-bottom: var(--space-section);
    border-bottom: 1px solid var(--c-line);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.45fr 0.95fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .hero__eyebrow {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--c-ink-3);
  }

  .hero__name {
    margin-top: var(--space-4);
    font-size: var(--text-hero);
    font-variation-settings: 'opsz' 72;
    line-height: 0.98;
    letter-spacing: -0.022em;
  }
  .hero__tagline {
    margin-top: var(--space-4);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-xl);
    line-height: 1.18;
    color: var(--c-ink-2);
    max-width: 22ch;
  }
  .hero__role {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--c-ink-3);
    letter-spacing: 0.02em;
  }

  .hero__actions {
    margin-top: var(--space-6);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .hero__social {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--c-ink-3);
  }
  .hero__social a { color: var(--c-ink-2); text-decoration: none; border-bottom: 1px solid var(--c-line-2); }
  .hero__social a:hover { color: var(--c-blue-link); border-color: var(--c-blue); }

  /* photo */
  .hero__plate { margin: 0; }
  .hero__frame {
    padding: 0.5rem;
    background: var(--c-paper-edge);
    border: 1px solid var(--c-line-2);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-2);
  }
  .hero__frame img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--r-sm);
  }
  .hero__cap {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--c-ink-2);
  }
  .hero__now { display: block; margin-bottom: 0.25rem; }

  /* entrance stagger */
  .hero__eyebrow, .hero__name, .hero__tagline, .hero__role, .hero__actions, .hero__plate {
    animation: hero-rise var(--dur-3) var(--ease-out) both;
  }
  .hero__name { animation-delay: 60ms; }
  .hero__tagline { animation-delay: 120ms; }
  .hero__role { animation-delay: 180ms; }
  .hero__actions { animation-delay: 240ms; }
  .hero__plate { animation-delay: 160ms; }
  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 52rem) {
    .hero__grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .hero__plate { order: -1; max-width: 17rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__eyebrow, .hero__name, .hero__tagline, .hero__role, .hero__actions, .hero__plate { animation: none; }
  }
</style>
