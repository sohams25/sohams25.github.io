---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';
import '../styles/tokens.css';
import '../styles/base.css';
import { meta, profile, education } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}
const { title = meta.title, description = meta.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, meta.url).href;
const ogImage = new URL('/og.png', meta.url).href;
const personImage = new URL('/images/ProfilePhoto.jpeg', meta.url).href;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  url: meta.url,
  email: `mailto:${profile.email}`,
  image: personImage,
  sameAs: [profile.links.github, profile.links.linkedin],
  worksFor: { '@type': 'Organization', name: 'Clutterbot', url: 'https://www.clutterbot.com/' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: education.school, url: education.schoolUrl },
  knowsAbout: ['Computer Vision', '3D Modeling', 'Applied Machine Learning', 'Robotics', 'Human-Computer Interaction'],
};
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={profile.name} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#faf8f4" />
    <!-- sits below the theme-color meta so it can correct it before paint;
         dark visitors would otherwise get a light address bar until theme.ts loads -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        var t;
        try {
          t = localStorage.getItem('theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
        } catch (e) {
          t = 'light';
        }
        d.dataset.theme = t;
        if (t === 'dark') {
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', '#101214');
        }
        d.classList.replace('no-js', 'js');
      })();
    </script>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={meta.ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Soham Shinde — Machine Learning Engineer" />
    <meta property="og:site_name" content={profile.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={meta.ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(personLd)} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
  </body>
</html>
